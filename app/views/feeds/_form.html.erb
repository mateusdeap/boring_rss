<turbo-frame id="new-feed">
  <div class="dialog-header">
    <span class="dialog-title">Add Feed</span>
    <button type="button" class="dialog-close" commandfor="my-dialog" command="close" aria-label="Close">✕</button>
  </div>
  <%= form_with model: feed, local: true, method: "dialog", class: "dialog-body" do |f| %>
    <div class="field-group">
      <%= f.label :link, "Feed URL", class: "field-label" %>
      <%= f.text_field :link, autofocus: true, class: [ "field", ("is-invalid" if feed.errors[:link].any?) ].compact.join(" ") %>
      <% if feed.errors[:link].any? %>
        <span class="field-error"><%= feed.errors[:link].to_sentence %></span>
      <% else %>
        <span class="field-hint">The feed's RSS or Atom URL.</span>
      <% end %>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn btn-secondary" commandfor="my-dialog" command="close">Cancel</button>
      <%= f.submit "Add Feed", class: "btn btn-primary" %>
    </div>
  <% end %>
</turbo-frame>
