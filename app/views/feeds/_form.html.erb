<turbo-frame id="new-feed">
  <div class="r-panel-h">ADD FEED</div>
  <%= form_with model: feed, local: true, method: "dialog", class: "r-stack r-pad" do |f| %>
    <% failed = feed.errors[:link].any? %>
    <div class="r-field" <%= "data-state=fail" if failed %>>
      <%= f.label :link, "Feed URL", class: "r-label" %>
      <%= f.text_field :link, autofocus: true, placeholder: "https://example.com/feed.xml", class: "r-input", aria: { invalid: failed, describedby: "feed_link_help" } %>
      <span class="r-help" id="feed_link_help">
        <% if failed %>
          ERR <%= feed.errors[:link].to_sentence %>
        <% else %>
          RSS or Atom URL.
        <% end %>
      </span>
    </div>
    <div class="r-field">
      <%= f.label :folder_name, "Folder", class: "r-label" %>
      <%= f.text_field :folder_name, list: "folder-names", autocomplete: "off", placeholder: "Optional", class: "r-input" %>
      <span class="r-help">An existing folder, or a new name to create one.</span>
    </div>
    <div class="r-dialog-actions">
      <button type="button" class="r-btn" commandfor="add-feed-dialog" command="close"><span class="r-key">ESC</span> Cancel</button>
      <%= f.submit "Add feed", class: "r-btn r-btn-primary" %>
    </div>
  <% end %>
</turbo-frame>
