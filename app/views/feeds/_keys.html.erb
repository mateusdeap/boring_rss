<%# Every shortcut selection_controller.js and reader_keys_controller.js
    handle. Keep them in step (and the reader's own list in
    items/_no_selection.html.erb). %>
<dialog id="keys-dialog" class="r-dialog">
  <div class="r-panel-h">KEYS</div>
  <div class="r-stack r-pad">
    <table class="r-table">
      <colgroup><col style="width:120px"><col></colgroup>
      <thead><tr><th>Key</th><th>Action</th></tr></thead>
      <tbody>
        <tr><td><span class="r-key">J</span> <span class="r-key">K</span></td><td>Next / previous item — opening marks it read</td></tr>
        <tr><td><span class="r-key">U</span></td><td>Toggle read / unread</td></tr>
        <tr><td><span class="r-key">M</span></td><td>Mark (highlight) item</td></tr>
        <tr><td><span class="r-key">V</span></td><td>Open original in a new tab ↗</td></tr>
        <tr><td><span class="r-key">/</span></td><td>Find in article</td></tr>
        <tr><td><span class="r-key">N</span> <span class="r-key">⇧N</span></td><td>Next / previous match (in the field: ↵ / ⇧↵)</td></tr>
        <tr><td><span class="r-key">T</span></td><td>Text size and measure</td></tr>
        <tr><td><span class="r-key">I</span></td><td>Expand / collapse details</td></tr>
        <tr><td><span class="r-key">SPACE</span> <span class="r-key">⇧SPACE</span></td><td>Page down / up in the article</td></tr>
        <tr><td><span class="r-key">C</span></td><td>Copy the focused code block</td></tr>
        <tr><td><span class="r-key">R</span></td><td>Poll now (when nothing is unread)</td></tr>
        <tr><td><span class="r-key">⇧U</span></td><td>Show unread items only / all items</td></tr>
        <tr><td><span class="r-key">S</span></td><td>Sort a group: newest first / by feed</td></tr>
        <tr><td><span class="r-key">⇧R</span></td><td>Mark all items in this list read</td></tr>
        <tr><td><span class="r-key">G</span> <span class="r-key">F</span></td><td>Left pane: Groups / Feeds</td></tr>
        <tr><td><span class="r-key">↑</span> <span class="r-key">↓</span></td><td>Move in the left pane (when focused)</td></tr>
        <tr><td><span class="r-key">↵</span> <span class="r-key">→</span></td><td>Open group or feed · expand group (Feeds mode)</td></tr>
        <tr><td><span class="r-key">←</span></td><td>Collapse group · go to its group row (Feeds mode)</td></tr>
        <tr><td><span class="r-key">A</span></td><td>Add feed</td></tr>
        <tr><td><span class="r-key">L</span></td><td>Show / hide fetch log</td></tr>
        <tr><td><span class="r-key">ESC</span></td><td>Close dialog · find bar · text bar, then back to items (under 1100px)</td></tr>
        <tr><td><span class="r-key">?</span></td><td>This list</td></tr>
      </tbody>
    </table>
    <div class="r-dialog-actions">
      <button class="r-btn" commandfor="keys-dialog" command="close" type="button"><span class="r-key">ESC</span> Close</button>
    </div>
  </div>
</dialog>
