<%# The app: feed tree, item list, reader. Every screen has its own URL —
    `/`, `/groups/:id`, `/feeds/:id`, `/marked`, and an item within each
    (`/groups/:group_id/items/:id`, …) — each rendering this whole
    shell with its own panes filled in, so reloads and the browser's back
    button land where you were on every layout. Tree and item links load
    into the frames and advance the address bar (data-turbo-action).

    data-screen (tree / items / reader) is which pane is in front where
    they don't all fit: under 1100px the reader replaces the item list,
    under 640px one pane shows at a time (Groups → Items → Reader, with
    Feeds opened from the Groups top bar).
    selection_controller.js moves it as frames load and on back.

    Keys: reader_keys_controller.js listens on the document and
    selection_controller.js on the window, so reader keys (Esc layers)
    run first and selection skips what they already handled.

    locals: screen, items_frame (HTML), reader_frame (HTML), and optionally
    tree_mode (groups / feeds; the user's saved mode otherwise) %>
<% tree_mode = local_assigns[:tree_mode] || Current.user.tree_mode %>
<% content_for :app_shell, "true" %>
<%= turbo_stream_from Current.user, :feeds %>
<div class="rdr-panes" data-screen="<%= screen %>"
     data-controller="context-menu selection"
     data-action="keydown@window->selection#key touchstart->selection#swipeStart touchend->selection#swipeEnd">
  <%# 01 GROUPS / 01 FEEDS (RDR-01 FeedTree). Both lists are rendered;
      data-tree-mode shows one. G / F (or the segmented control) switch it
      client-side and save it (selection_controller.js#setMode); opening a
      group or a feed switches to the mode that lists it. The header counts
      come from the feed rows (status_bar_controller.js). Marked sits under
      both lists. %>
  <section class="rdr-pane rdr-pane-tree" aria-label="Feeds" data-tree-mode="<%= tree_mode %>">
    <div class="r-panel-h">
      <span><span class="rdr-mode-groups">01 GROUPS</span><span class="rdr-mode-feeds">01 FEEDS</span></span>
      <span class="r-label"><span class="rdr-mode-feeds"><span data-tree-summary="feeds">0</span> feeds · </span><span data-tree-summary="unread">0</span> unread</span>
      <%# Phone (< 640px): the top bar opens Feeds from Groups and back. %>
      <button type="button" class="rdr-phone-mode rdr-mode-groups" data-action="selection#showFeeds">Feeds →</button>
      <button type="button" class="rdr-phone-mode rdr-mode-feeds" data-action="selection#showGroups">← Groups</button>
    </div>
    <div class="r-modebar">
      <div class="r-seg" role="group" aria-label="Left pane">
        <button type="button" class="r-btn" data-tree-mode-button="groups" aria-pressed="<%= tree_mode == "groups" %>" data-action="selection#showGroups"><span class="r-key">G</span> Groups</button>
        <button type="button" class="r-btn" data-tree-mode-button="feeds" aria-pressed="<%= tree_mode == "feeds" %>" data-action="selection#showFeeds"><span class="r-key">F</span> Feeds</button>
      </div>
    </div>
    <div class="rdr-pane-scroll">
      <ul class="r-tree rdr-mode-groups" role="tree" aria-label="Groups" id="groups" data-action="keydown->selection#treeKey">
        <%= render "groups/tree", user: Current.user %>
      </ul>
      <ul class="r-tree rdr-mode-feeds" role="tree" aria-label="Feeds" id="feeds" data-action="contextmenu->context-menu#open keydown->selection#treeKey">
        <%= render "feeds/tree", user: Current.user %>
      </ul>
      <ul class="r-tree rdr-marked-list" role="tree" aria-label="Marked" data-action="keydown->selection#treeKey">
        <%= render "feeds/marked_row", user: Current.user %>
      </ul>
    </div>
    <%# Pane footer (canvas ModeFeeds): Add feed, in both modes — the mode
        bar holds only the G / F control, which fills the 248px pane. %>
    <div class="rdr-tree-foot">
      <button type="button" class="rdr-text-btn" command="show-modal" commandfor="add-feed-dialog"><span class="r-key">A</span> Add feed</button>
    </div>
  </section>

  <section class="rdr-pane rdr-pane-items" aria-label="Items">
    <%= items_frame || render("feeds/no_feed") %>
  </section>

  <section class="rdr-pane rdr-pane-reader" aria-label="Reader"
           data-controller="reader-keys reader-loading"
           data-action="keydown@document->reader-keys#key turbo:before-fetch-request->reader-loading#start turbo:frame-render->reader-loading#stop turbo:fetch-request-error->reader-loading#stop">
    <%= reader_frame || render("items/no_selection") %>
    <%= render "items/loading" %>
  </section>

  <%= render "feeds/context_menu" %>
</div>

<%= render "feeds/keys" %>
<%= render "folders/dialogs" %>
<%= render "folders/datalist", user: Current.user %>

<dialog id="add-feed-dialog" class="r-dialog" data-controller="add-feed-modal" data-action="turbo:submit-end->add-feed-modal#handleSubmission">
  <%= render "feeds/form", feed: Feed.new %>
</dialog>
