<%= turbo_stream_from Current.user, :feeds %>
<div class="rdr-panes" data-controller="context-menu selection" data-action="keydown@document->selection#key">
  <section class="rdr-pane rdr-pane-tree" aria-label="Feeds">
    <div class="r-panel-h">
      01 FEEDS
      <button class="r-btn r-btn-primary" command="show-modal" commandfor="add-feed-dialog"><span class="r-key">A</span> Add feed</button>
    </div>
    <div class="rdr-pane-scroll">
      <ul class="r-tree" role="tree" aria-label="Feeds" id="feeds" data-action="contextmenu->context-menu#open keydown->selection#treeKey">
        <%= render partial: "feeds/feed", collection: @feeds %>
      </ul>
    </div>
  </section>

  <section class="rdr-pane rdr-pane-items" aria-label="Items">
    <turbo-frame id="current_feed" data-action="turbo:frame-render->selection#feedNavigated">
      <div class="r-panel-h">02 ITEMS</div>
      <p class="r-empty">No feed selected.</p>
    </turbo-frame>
  </section>

  <section class="rdr-pane rdr-pane-reader" aria-label="Reader">
    <turbo-frame id="current_item" data-action="turbo:frame-render->selection#itemNavigated">
      <div class="r-panel-h">03 READER</div>
      <p class="r-empty">No item selected.</p>
    </turbo-frame>
  </section>

  <%= render "feeds/context_menu" %>
</div>

<%= render "feeds/keys" %>

<dialog id="add-feed-dialog" class="r-dialog" data-controller="add-feed-modal" data-action="turbo:submit-end->add-feed-modal#handleSubmission">
  <%= render "form", feed: Feed.new %>
</dialog>
