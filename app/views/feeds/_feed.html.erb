<%# RDR-01 FeedTree row. data-unread/data-health/data-fetched-at feed the
    StatusBar (status_bar_controller.js); aria-selected/is-focused are set
    by selection_controller.js, which also moves the roving tabindex. There are no folders yet, so the disclosure
    column stays empty. Health column: the failing status (code or word)
    while the last poll failed, otherwise the age of the last poll; the
    hover text spells out the full detail. %>
<% unread = feed.unread_count %>
<% health = feed.fetch_failed? ? "fail" : (feed.last_fetched_at? ? "ok" : "unknown") %>
<li id="<%= dom_id feed %>" role="treeitem" aria-selected="false" tabindex="-1"
    data-feed-id="<%= feed.id %>" data-unread="<%= unread %>" data-health="<%= health %>"
    data-fetched-at="<%= feed.last_fetched_at&.utc&.iso8601 %>"
    class="<%= "has-unread" if unread.positive? %>">
  <span></span>
  <%# tabindex -1: the row is the tab stop (roving tabindex); Enter on it clicks this. %>
  <%= link_to feed.title, feed_path(feed.id), data: { turbo_frame: "current_feed" }, class: "r-name", tabindex: -1 %>
  <% if feed.fetch_failed? %>
    <%= status_code_tag feed.last_fetch_status, title: fetch_failure_summary(feed) %>
  <% elsif feed.last_fetched_at? %>
    <span class="r-dim" title="<%= feed.last_fetch_status %> · <%= feed.last_fetch_detail %> · <%= rdr_time(feed.last_fetched_at) %>"><%= rdr_age(feed.last_fetched_at) %></span>
  <% else %>
    <span class="r-dim" title="Not fetched since it was added">—</span>
  <% end %>
  <span class="r-count<%= " r-count-0" if unread.zero? %>"><%= rdr_number(unread) %></span>
</li>
