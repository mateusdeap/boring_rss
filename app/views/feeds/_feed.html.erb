<article id="<%= dom_id feed %>" data-feed-id="<%= feed.id %>">
  <header>
    <p class="text-sm flex items-center gap-1">
      <%= link_to feed.title, feed_path(feed.id), data: { turbo_frame: "current_feed" } %>
      <% if feed.unread_count.positive? %>
        <span class="text-xs border rounded-full px-1.5"><%= feed.unread_count %></span>
      <% end %>
    </p>
  </header>
</article>
