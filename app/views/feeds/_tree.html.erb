<%# The whole feed tree, flat (RDR-01 FeedTree): each folder row followed
    by its feeds, then the top-level feeds. Rendered on page load and by
    FeedTreeStreams#tree_streams after any structural change. The Marked
    row always comes first. %>
<%= render "feeds/marked_row", user: %>
<% user.folders.alphabetical.includes(:feeds).each do |folder| %>
  <%= render "folders/folder", folder: %>
  <%= render partial: "feeds/feed", collection: folder.feeds.sort_by(&:id), as: :feed %>
<% end %>
<%= render partial: "feeds/feed", collection: user.feeds.where(folder_id: nil).order(:id), as: :feed %>
