<%# Fixed last row of the left pane, under both modes' lists: opens the
    Marked view. The count uses
    RDR-01's `mark` token (ink on mark) — never `signal`, which means
    unread only. Replaced by Items::MarksController after every toggle. No
    data-feed-id/data-folder-id: the StatusBar and context menu skip it. %>
<% count = user.items.marked.count %>
<li id="marked_view" role="treeitem" aria-selected="false" tabindex="-1" class="rdr-marked-row">
  <span></span>
  <%= link_to "Marked", marked_items_path, data: { turbo_frame: "current_feed", turbo_action: "advance" }, class: "r-name", tabindex: -1 %>
  <span></span>
  <span class="r-count <%= count.zero? ? "r-count-0" : "rdr-count-mark" %>"><%= rdr_number(count) %></span>
</li>
