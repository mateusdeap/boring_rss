<turbo-frame id="new_feed">
  <%= form_with model: @feed, local: true do |f| %>
    <% if @feed.errors.any? %>
      <div>
        <h2><%= pluralize(@feed.errors.count, "error") %> prohibited this article from being saved:</h2>
        <ul>
          <% @feed.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= f.label :link, "Link:" %>
    <%= f.text_field :link %>
    <%= f.submit "Add feed" %>
  <% end %>
  <%= link_to "Cancel", feeds_path, data_turbo_frame: "_top" %>
</turbo-frame>
