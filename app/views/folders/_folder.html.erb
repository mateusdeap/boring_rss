<%# RDR-01 FeedTree folder row (Feeds mode): disclosure · name · worst
    health of its feeds (1 ERR, 1 STALE, else OK) · summed unread.
    Clicking (or Enter/←/→, selection_controller.js) toggles it; the state
    is saved on the folder. No data-feed-id, so the StatusBar doesn't count
    it twice. %>
<% unread = folder.unread_count %>
<% health = folder.health %>
<li id="<%= dom_id folder %>" role="treeitem" tabindex="-1"
    aria-expanded="<%= !folder.collapsed? %>"
    data-folder-id="<%= folder.id %>" data-folder-name="<%= folder.name %>"
    data-action="click->selection#toggleFolder"
    class="r-folder<%= " has-unread" if unread.positive? %>">
  <span aria-hidden="true" data-disclosure><%= folder.collapsed? ? "▸" : "▾" %></span>
  <span class="r-name"><%= folder.name %></span>
  <% if folder.feeds.empty? %>
    <span class="r-dim" title="Empty folder">—</span>
  <% else %>
    <span class="r-code r-code-<%= health.tone %>" title="<%= (health.failing + health.stale).map { |feed| "#{feed.title}: #{feed.health.upcase}" }.join("\n").presence || "Every feed fetched without error and on schedule" %>"><%= health.label %></span>
  <% end %>
  <span class="r-count<%= " r-count-0" if unread.zero? %>"><%= rdr_number(unread) %></span>
</li>
