<%# RDR-01 FeedTree folder row: disclosure · name · worst health of its
    feeds · summed unread. Clicking (or Enter/←/→, selection_controller.js)
    toggles it; the state is saved on the folder. No data-feed-id, so the
    StatusBar doesn't count it twice. %>
<% unread = folder.unread_count %>
<% failing = folder.failing_feeds %>
<% last_fetched_at = folder.last_fetched_at %>
<li id="<%= dom_id folder %>" role="treeitem" tabindex="-1"
    aria-expanded="<%= !folder.collapsed? %>"
    data-folder-id="<%= folder.id %>" data-folder-name="<%= folder.name %>"
    data-action="click->selection#toggleFolder"
    class="r-folder<%= " has-unread" if unread.positive? %>">
  <span aria-hidden="true" data-disclosure><%= folder.collapsed? ? "▸" : "▾" %></span>
  <span class="r-name"><%= folder.name %></span>
  <% if failing.any? %>
    <%= status_code_tag "#{failing.size} ERR", title: failing.map { |feed| "#{feed.title}: #{feed.last_fetch_status} #{feed.last_fetch_detail}" }.join("\n") %>
  <% elsif last_fetched_at %>
    <span class="r-dim" title="Newest fetch in this folder: <%= rdr_time(last_fetched_at) %>"><%= rdr_age(last_fetched_at) %></span>
  <% else %>
    <span class="r-dim" title="<%= folder.feeds.empty? ? "Empty folder" : "Not fetched yet" %>">—</span>
  <% end %>
  <span class="r-count<%= " r-count-0" if unread.zero? %>"><%= rdr_number(unread) %></span>
</li>
