<%# RDR-01 Reader: mono metadata block stating where the item came from,
    then the article in sans at the 68ch measure. %>
<div class="r-panel-h">
  03 READER
  <button type="button" class="r-btn rdr-back" data-action="selection#back"><span class="r-key">ESC</span> Back to items</button>
</div>
<article class="r-reader rdr-pane-scroll" data-item-id="<%= item.id %>">
  <% safe_link = safe_item_link(item.link) %>
  <h1 class="r-headline">
    <% if safe_link %>
      <%= link_to item.title, safe_link, target: "_blank", rel: "noopener" %>
    <% else %>
      <%= item.title %>
    <% end %>
  </h1>

  <dl class="r-meta">
    <dt>Source</dt>
    <dd>
      <%= item.feed.title %>
      <% if safe_link %>
        · <%= link_to "#{safe_link.sub(%r{\Ahttps?://}, "")} ↗", safe_link, target: "_blank", rel: "noopener", data: { original_link: true } %>
        <span class="r-key">O</span>
      <% end %>
    </dd>
    <% if item.published_at %>
      <dt>Published</dt>
      <dd><%= rdr_time(item.published_at) %> <span class="r-dim">(<%= rdr_age(item.published_at) %>)</span></dd>
    <% end %>
    <% if item.summary.present? %>
      <dt>Length</dt>
      <dd><%= rdr_number(strip_tags(item.summary).split.size) %> w <span class="r-dim">· <%= rdr_bytes(item.summary.bytesize) %> as supplied by the feed</span></dd>
    <% end %>
    <dt>First seen</dt>
    <dd>
      <%= rdr_time(item.created_at) %>
      <% if item.guid.present? %>
        <span class="r-dim">· GUID <span title="<%= item.guid %>"><%= item.guid.truncate(40) %></span></span>
      <% end %>
    </dd>
  </dl>

  <div class="r-body">
    <%= sanitized_summary(item) %>
  </div>
</article>
