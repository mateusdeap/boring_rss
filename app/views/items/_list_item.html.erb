<article id="<%= dom_id item %>" class="timeline-row<%= " is-read" if item.read? %>">
  <span class="timeline-row-dot<%= " is-unread" unless item.read? %>"></span>
  <%= link_to item.title, item_path(item), data: { turbo_frame: "current_item", turbo_prefetch: false }, class: "min-w-0 flex-1 truncate" %>
  <% if item.published_at %>
    <span class="text-[11px] text-text-faint shrink-0"><%= item.published_at.strftime("%-l:%M") %></span>
  <% end %>
</article>
