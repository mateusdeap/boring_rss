<turbo-frame id="current_item">
  <article class="flex flex-col" id="<%= dom_id item %>">
    <header>
      <% if (safe_link = safe_item_link(item.link)) %>
        <%= link_to item.title, safe_link %>
      <% else %>
        <%= item.title %>
      <% end %>
    </header>
    <%= sanitize item.summary %>
  </article>
</turbo-frame>
