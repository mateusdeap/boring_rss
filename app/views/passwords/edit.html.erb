<div class="r-page">
  <div class="r-panel">
    <h1 class="r-panel-h">NEW PASSWORD</h1>
    <%= form_with url: password_path(params[:token]), method: :put, class: "r-stack r-pad" do |form| %>
      <%= render "layouts/flash" %>

      <div class="r-field">
        <%= form.label :password, "New password", class: "r-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "r-input" %>
      </div>

      <div class="r-field">
        <%= form.label :password_confirmation, "Repeat password", class: "r-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "r-input" %>
      </div>

      <div>
        <%= form.submit "Save", class: "r-btn r-btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
