<%# 02 ITEMS for a group (RDR-01 ItemTable, merged river): every item of
    the group's feeds, newest first, with a FEED column since the list
    spans several feeds. Row updates arrive on the user's own stream,
    which the app shell subscribes to. %>
<turbo-frame id="current_feed" data-action="turbo:frame-render->selection#feedNavigated">
  <div class="r-panel-h">
    <%= link_to "← GROUPS", root_path, class: "rdr-phone-back", data: { turbo_frame: "_top", reader_back: "items" } %>
    <span class="truncate">02 ITEMS — <%= @group.name %></span>
    <span class="r-label"><%= pluralize(rdr_number(@group.feeds.size), "feed") %> · <%= rdr_number(@unread_count) %> unread</span>
  </div>
  <div class="rdr-toolbar">
    <%= button_to preferences_path, method: :patch, form: { class: "contents" },
          params: { user: { unread_only: !Current.user.unread_only? }, return_to: group_path(@group) },
          class: "r-btn", aria: { pressed: Current.user.unread_only? }, data: { shortcut: "shift+u" } do %>
      <span class="r-key">⇧U</span> Unread only
    <% end %>
  </div>
  <div class="rdr-pane-scroll">
    <table class="r-table" role="grid">
      <colgroup><col style="width:24px"><col><col style="width:128px"><col style="width:72px"></colgroup>
      <thead><tr><th></th><th>Title</th><th>Feed</th><th class="r-num">Age</th></tr></thead>
      <tbody id="items" data-tree-row="<%= @group.dom_id %>">
        <%= render partial: "items/list_item", collection: @items, as: :item %>
      </tbody>
    </table>
    <% if @items.none? %>
      <p class="r-empty">
        <% if Current.user.unread_only? && @group.items.exists? %>
          No unread items. <span class="r-key">⇧U</span> shows the read ones.
        <% else %>
          No items.
        <% end %>
      </p>
    <% end %>
  </div>
</turbo-frame>
