<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Boring Rss" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Boring Rss">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;600&display=swap">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body <%= tag.attributes(theme_attribute) %>>
    <main class="mx-auto mt-6 px-5">
      <div class="flex justify-end items-center gap-2 text-xs text-text-faint mb-2">
        <% if authenticated? %>
          <%= form_with model: Current.user, url: preferences_path, method: :patch, data: { controller: "theme-select" } do |f| %>
            <%= f.select :theme, User.themes.keys.map { |t| [ t.capitalize, t ] }, {}, class: "text-xs border-0 bg-transparent text-text-faint cursor-pointer", data: { action: "change->theme-select#submit" } %>
          <% end %>
        <% end %>
        <button class="underline hover:no-underline cursor-pointer bg-transparent border-0 p-0" command="show-modal" commandfor="tip-dialog">⚡ Tip</button>
        <% if authenticated? %>
          <span><%= Current.user.email_address %></span>
          <%= button_to "Sign out", session_path, method: :delete, class: "underline hover:no-underline cursor-pointer bg-transparent border-0 p-0" %>
        <% end %>
      </div>
      <%= yield %>
    </main>

    <dialog id="tip-dialog" class="m-auto p-4 text-center">
      <p class="font-medium mb-2">Enjoying this? Send some sats, no obligation.</p>
      <%= image_tag "lightning_tip_qr.svg", alt: "Lightning Address QR code for peartree@getalby.com", class: "mx-auto w-48 h-48" %>
      <p class="mt-2"><%= link_to "peartree@getalby.com", "lightning:peartree@getalby.com" %></p>
      <button class="mt-3 border px-2" commandfor="tip-dialog" command="close" type="button">Close</button>
    </dialog>
  </body>
</html>
